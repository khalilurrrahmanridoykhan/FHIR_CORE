meta {
  name: Create Test Patient
  type: http
  seq: 1
}

post {
  url: {{hapiBaseUrl}}/Patient
  body: json
  auth: none
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "name": [{ "use": "official", "family": "FHIR Learning", "given": ["TEST -"] }],
    "gender": "unknown"
  }
}

script:post-response {
  bru.setVar("createdPatientId", res.body.id);
}

docs {
  This is a real POST -- it creates a new Patient on the public sandbox.
  The response's id is saved into the createdPatientId variable -- the next two
  requests (read-back, delete) use it. Run in order: 1, 2, 3.
}
