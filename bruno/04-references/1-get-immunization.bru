meta {
  name: Get an Immunization
  type: http
  seq: 1
}

get {
  url: {{smartBaseUrl}}/Immunization?_count=1
  body: none
  auth: none
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  const imm = res.body.entry[0].resource;
  const [resourceType, id] = imm.patient.reference.split("/");
  bru.setVar("refResourceType", resourceType);
  bru.setVar("refId", id);
}

docs {
  Run this one first. It reads the first Immunization's patient.reference and
  splits it into refResourceType/refId variables -- the next request uses those
  to fetch the actual Patient resource.
}
