meta {
  name: Fetch IMMZ.Immunization StructureDefinition
  type: http
  seq: 1
}

get {
  url: https://worldhealthorganization.github.io/smart-immunizations/StructureDefinition-IMMZ.Immunization.json
  body: none
  auth: none
}

docs {
  This fetches WHO's own machine-readable IG profile directly -- the response's
  differential.element array gives each field's path and min/max (cardinality).
  This is where exercise.mjs's sample elements were taken from.
}
