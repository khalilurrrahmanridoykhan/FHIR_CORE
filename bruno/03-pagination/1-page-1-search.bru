meta {
  name: Page 1 - Search Immunizations
  type: http
  seq: 1
}

get {
  url: {{smartBaseUrl}}/Immunization?_count=2
  body: none
  auth: none
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  const nextLink = res.body.link?.find((l) => l.relation === "next");
  bru.setVar("nextPageUrl", nextLink ? nextLink.url : "");
}

docs {
  Run this request first. It reads the "next" URL out of the response's link[] array
  and saves it into a variable called nextPageUrl -- the next request ("Page 2") uses it.
}
