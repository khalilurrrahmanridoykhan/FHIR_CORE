meta {
  name: Page 2 - Follow next link
  type: http
  seq: 2
}

get {
  url: {{nextPageUrl}}
  body: none
  auth: none
}

headers {
  Accept: application/fhir+json
}

docs {
  This uses the nextPageUrl variable set by the previous request ("Page 1") --
  so run "Page 1" once first, or this URL will be empty.
  Notice -- this URL has no "Immunization" path, just query parameters -- this is
  exactly the real pagination bug described in the README.
}
