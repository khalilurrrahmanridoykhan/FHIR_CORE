meta {
  name: Page 2 - Follow next link
  type: http
  seq: 2
}

get {
  url: {{nextPageUrl}}
  body: none
  auth: none
}

headers {
  Accept: application/fhir+json
}

docs {
  এটা আগের রিকোয়েস্ট ("Page 1") থেকে পাওয়া nextPageUrl variable ব্যবহার করে --
  তাই "Page 1" আগে একবার রান করা লাগবে, নাহলে এই URL খালি থাকবে।
  লক্ষ্য করুন -- এই URL-এ "Immunization" path নেই, শুধু query parameter -- এটাই
  README-তে উল্লেখিত real pagination bug-এর মূল কারণ।
}
